# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local and fill in your values
#
# IMPORTANT: .env.local is NOT committed to git
# Set the same variables in Vercel project settings
# for production/preview deployments

# ============================================
# WEBSITE URL (IMPORTANT!)
# ============================================
# For local dev:
# NEXT_PUBLIC_WEBSITE=http://localhost:3000
# For Vercel preview:
NEXT_PUBLIC_WEBSITE=https://trfsk-website.vercel.app
# For production (custom domain):
# NEXT_PUBLIC_WEBSITE=https://www.trfskomkar.com

NEXT_PUBLIC_COMPANY_NAME=TRFSK OMKAR SERVICES PVT LTD

# ============================================
# DATABASE (for future use)
# ============================================
# DATABASE_URL="postgresql://user:password@localhost:5432/trfsk_website?schema=public"

# ============================================
# ZOHO SMTP CONFIGURATION
# ============================================
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=care@trfskomkar.com
SMTP_PASS=your-zoho-app-specific-password

# ============================================
# COMPANY EMAILS
# ============================================
ADMIN_EMAIL=admin@trfskomkar.com
CONTACT_EMAIL=care@trfskomkar.com
CARE_EMAIL=care@trfskomkar.com
PARTNER_EMAIL=partners@trfskomkar.com
SUBSCRIBER_EMAIL=subscribers@trfskomkar.com
DOCUMENT_EMAIL=documents@trfskomkar.com

# ============================================
# WEBSITE CONTACT DETAILS
# ============================================
COMPANY_PHONE=+918169302861
COMPANY_ADDRESS=DNK Business Bay, Katraj, Pune, Maharashtra 411046

# ============================================
# GOOGLE ANALYTICS
# ============================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# ZOHO CRM OAUTH
# ============================================
# For local dev, use localhost
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/callback

# ============================================
# ZOHO CRM TOKENS
# ============================================
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# ============================================
# ZOHO CRM API
# ============================================
ZOHO_API_DOMAIN=https://www.zohoapis.in

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV=development
