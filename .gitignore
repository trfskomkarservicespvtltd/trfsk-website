/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit these
.env
.env.local
.env.development
.env.production
.env.test
.env*.local
.env.development.local
.env.production.local
.env.test.local
*.env

