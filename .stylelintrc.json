{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "apply",
          "tailwind",
          "layer",
          "import",
          "supports",
          "document",
          "font-feature-values",
          "counter-style",
          "font-palette-values",
          "property"
        ]
      }
    ],
    "no-descending-specificity": null,
    "function-no-unknown": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ]
  },
  "ignoreFiles": ["node_modules/**", ".next/**", "out/**"]
}
