generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  leadId        String   @unique
  source        String
  status        String   @default("NEW")
  name          String?
  email         String
  phone         String?
  company       String?
  subject       String?
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([source])
  @@index([status])
}
